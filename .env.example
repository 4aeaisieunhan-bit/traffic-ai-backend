# Mẫu cấu hình — copy thành file .env rồi điền giá trị của máy bạn (KHÔNG đẩy .env lên GitHub)

# DB_TYPE: mssql (Microsoft SQL Server) hoặc sqlite
DB_TYPE=mssql

# Microsoft SQL Server
MSSQL_SERVER=localhost\SQLEXPRESS
MSSQL_DATABASE=traffic_ai_db
MSSQL_DRIVER=ODBC Driver 17 for SQL Server
MSSQL_TRUSTED_CONNECTION=yes
# Nếu dùng SQL Server Authentication:
# MSSQL_TRUSTED_CONNECTION=no
# MSSQL_USER=sa
# MSSQL_PASSWORD=

# Thiết bị chạy AI: auto | cpu | cuda | 0
# AI_DEVICE=auto

# Khi frontend ở tên miền khác (VD Vercel):
# CORS_ORIGINS=https://ten-du-an.vercel.app
# CROSS_SITE_COOKIE=1

# Tài khoản quản trị đầu tiên (chỉ tạo khi hệ thống chưa có quản trị viên nào).
# Không đặt ADMIN_PASSWORD -> sinh mật khẩu ngẫu nhiên và in 1 lần ra console lúc khởi động.
# ADMIN_EMAIL=admin@gmail.com
# ADMIN_PASSWORD=

# Tài khoản tự đăng ký phải được quản trị viên kích hoạt. Đặt 1 để kích hoạt ngay (chỉ dùng khi demo trên máy cá nhân).
# AUTO_APPROVE_REGISTRATION=0

# Video mẫu cho nút "Dùng video mẫu" (không có trong Git). Mặc định tìm sample.mp4 / 21s_vidnew.mov trong thư mục backend.
# SAMPLE_VIDEO=D:/videos/nga-tu.mp4

# Đổi file trọng số mô hình (đường dẫn tuyệt đối hoặc tương đối với thư mục backend). Mặc định là các file trong weights_demo/
# VEHICLE_WEIGHTS=weights_demo/phuongtienmoi.pt
# TRAFFIC_LIGHT_WEIGHTS=weights_demo/dengiaothong.pt
# HELMET_WEIGHTS=weights_demo/mubaohiem.pt
# LICENSE_PLATE_WEIGHTS=weights_demo/biensoxe.pt
# STOP_LINE_WEIGHTS=weights_demo/vachdung.pt
# OCR_WEIGHTS=weights_demo/kytu.pt
