# Mẫu cấu hình — copy thành file .env rồi điền giá trị của máy bạn (KHÔNG đẩy .env lên GitHub)

# DB_TYPE: mssql (Microsoft SQL Server) hoặc sqlite
DB_TYPE=mssql

# Microsoft SQL Server
MSSQL_SERVER=localhost\SQLEXPRESS
MSSQL_DATABASE=traffic_ai_db
MSSQL_DRIVER=ODBC Driver 17 for SQL Server
MSSQL_TRUSTED_CONNECTION=yes
# Nếu dùng SQL Server Authentication:
# MSSQL_TRUSTED_CONNECTION=no
# MSSQL_USER=sa
# MSSQL_PASSWORD=

# Thiết bị chạy AI: auto | cpu | cuda | 0
# AI_DEVICE=auto

# Khi frontend ở tên miền khác (VD Vercel):
# CORS_ORIGINS=https://ten-du-an.vercel.app
# CROSS_SITE_COOKIE=1

# Đổi mô hình mũ bảo hiểm (mặc định weights_demo/mubaohiem.pt)
# HELMET_WEIGHTS=weights/helmet_v2.pt
